# ---------------------------------------------------------------------------
# To The Crown — variables d'environnement
# Copier vers apps/server/.env (développement) ou .env (docker compose).
# Ne jamais committer de vrai secret.
# ---------------------------------------------------------------------------

# Environnement : development | production | test
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# PostgreSQL (obligatoire)
DATABASE_URL=postgres://ttc:ttc@localhost:5432/tothecrown

# Redis (facultatif : limitation de débit partagée et adaptateur Socket.IO)
REDIS_URL=redis://localhost:6379
SOCKET_REDIS_ADAPTER=false

# Secret de signature des sessions : 32 caractères minimum.
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=remplacer-par-un-secret-long-et-aleatoire-de-48-octets

# Origine publique du client (vérification CSRF et CORS Socket.IO)
APP_ORIGIN=http://localhost:5173

# Cookies Secure : auto (Secure en production), true ou false
COOKIE_SECURE=auto

# Faire confiance à X-Forwarded-For : uniquement derrière un proxy inverse maîtrisé
TRUST_PROXY=false

# Outils de développement (ignorés en production)
DEV_TOOLS=true

# Appliquer les migrations au démarrage du serveur
MIGRATE_ON_START=false

# Servir le client compilé depuis le serveur (chemin vers apps/web/dist), vide = désactivé
SERVE_WEB_DIST=

# Durée d'un jour de jeu en ms pour les vitesses 1, 2 et 3
TICK_MS=600,250,90

# Délai minimal entre deux sauvegardes automatiques (secondes)
AUTOSAVE_MIN_SECONDS=20

# Inscriptions autorisées par adresse IP et par heure
REGISTER_LIMIT_PER_HOUR=10

LOG_LEVEL=info

# Docker compose uniquement
POSTGRES_PASSWORD=ttc
WEB_PORT=8080
